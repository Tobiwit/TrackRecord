# --- Track Record environment variables ---
# The app runs fully without any of these (local demo mode with mock data).
# Fill them in to enable real backends.

# Supabase (auth + database + storage) — optional
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Spotify Web API — optional (enables real song search + previews)
# Create an app at https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
